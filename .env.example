# Google OAuth App Credentials
# Obtain your Client ID from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Master Platform Google Account Settings (Optional)
# If provided, EduKatalyst will automatically stream master course content from this central account for all visitors
VITE_MASTER_GOOGLE_DRIVE_TOKEN=your_master_account_access_token
VITE_MASTER_GOOGLE_FOLDER_ID=your_master_google_drive_folder_id
