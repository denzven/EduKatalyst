# Google OAuth App Public Client ID
# Obtain your Client ID from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# IMPORTANT: VITE_* environment variables are bundled into public client JS.
# Public OAuth Client IDs are safe to expose, but private secrets (Client Secret, Refresh Tokens)
# MUST NEVER be placed in client environment files. Private secrets belong in GitHub Actions Secrets.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Master Public Content Folder ID (Optional)
VITE_MASTER_GOOGLE_FOLDER_ID=your_master_google_drive_folder_id

